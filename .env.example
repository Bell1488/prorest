# Telegram bot created via @BotFather. Never commit the real values.
TELEGRAM_BOT_TOKEN=123456:replace-me
# Group/channel id, usually a negative number such as -1001234567890
TELEGRAM_CHAT_ID=-1001234567890
# SOCKS5H proxy. The h suffix forces DNS resolution through the proxy.
SOCKS5H_PROXY=socks5h://user:password@proxy.example.com:1080
PORT=8787

# Optional Yandex Metrica counter id, exposed to the browser intentionally.
VITE_YANDEX_METRIKA_ID=00000000
